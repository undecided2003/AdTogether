rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function verifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    match /ads/{userId}/{allPaths=**} {
      // Allow anyone to read ad images
      allow read: if true;
      // Only the owner can upload/modify images in their folder
      allow write: if verifiedUser() && request.auth.uid == userId;
    }
  }
}
