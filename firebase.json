{
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "frameworksBackend": {
      "region": "us-central1",
      "memory": "1GiB",
      "concurrency": 80,
      "maxInstances": 10,
      "minInstances": 0
    },
    "headers": [
      {
        "source": "/sdk.js",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800" },
          { "key": "Access-Control-Allow-Origin", "value": "*" }
        ]
      },
      {
        "source": "/llms*.txt",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800" },
          { "key": "Access-Control-Allow-Origin", "value": "*" }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|ico)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ],
    "redirects": [
      { "source": "/wp-admin**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/wp-login.php", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/wp-content**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/xmlrpc.php", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/.env**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/.git**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/.svn**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/.aws**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/phpmyadmin**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/adminer**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/vendor/phpunit**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/cgi-bin**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/manager/html**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/server-status**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/actuator**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/*.php", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/wp-admin/**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/wp-content/**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/.env/**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/.git/**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/.svn/**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/.aws/**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/.hg/**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/phpmyadmin/**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/adminer/**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/vendor/phpunit/**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/cgi-bin/**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/manager/html/**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/server-status/**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/actuator/**", "type": 301, "destination": "https://www.ad-together.org/" },
      { "source": "/**/*.php", "type": 301, "destination": "https://www.ad-together.org/" }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
